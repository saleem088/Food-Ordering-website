# =====================================================
# .env - Server settings and secrets
# Project : Tasty Bites Online Ordering System
# NEVER commit this file to GitHub (it is in .gitignore).
# Format  : KEY=value   (no quotes, no spaces around "=")
# =====================================================

# ---------- Server ----------
NODE_ENV=development
PORT=5000

# ---------- Login tokens ----------
# Paste the 96-character string you generated. Minimum 16 characters.
JWT_SECRET=PASTE_YOUR_GENERATED_SECRET_HERE
JWT_EXPIRES_IN=1d

# ---------- Allowed website addresses (CORS) ----------
# Comma separated, no spaces. These are the addresses Live Server uses.
# To demo on a phone, add its address, e.g. http://192.168.1.5:5500
CLIENT_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5501,http://localhost:5501

# ---------- Admin account (created ONCE, on the first run) ----------
ADMIN_EMAIL=admin@tastybites.com
ADMIN_PASSWORD=Admin12345

# ---------- Database ----------
# Leave commented to use server/database/foodapp.db
# DB_PATH=database/foodapp.db

# ---------- Delivery (must equal client config.js) ----------
DELIVERY_FEE=150
FREE_DELIVERY_ABOVE=2000